@model IEnumerable<BE.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Dùng Layout Khách hàng
}

<h2 style="margin-top: 30px; color: #2c3e50; text-align: center; font-weight: bold;">🛒 GIỎ HÀNG CỦA BẠN</h2>

@if (Model == null || !Model.Any())
{
    <!-- Hiển thị khi giỏ hàng trống -->
    <div style="background-color: #fcf8e3; border: 1px solid #faebcc; color: #8a6d3b; padding: 20px; text-align: center; border-radius: 5px; margin-top: 20px;">
        <h4 style="margin: 0;">Giỏ hàng của bạn hiện đang trống!</h4>
        <p style="margin-top: 10px;">Hãy quay lại trang chủ để chọn cho mình những món đồ ưng ý nhé.</p>
        <a href="/" style="display: inline-block; margin-top: 15px; background-color: #3498db; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Quay lại mua sắm</a>
    </div>
}
else
{
    <!-- Hiển thị bảng chi tiết khi có hàng -->
    <table style="width: 100%; margin-top: 20px; border-collapse: collapse; background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <thead style="background-color: #34495e; color: white;">
            <tr>
                <th style="padding: 15px; text-align: center; border: 1px solid #ddd;">Hình ảnh</th>
                <th style="padding: 15px; text-align: left; border: 1px solid #ddd;">Tên sản phẩm</th>
                <th style="padding: 15px; text-align: center; border: 1px solid #ddd;">Đơn giá</th>
                <th style="padding: 15px; text-align: center; border: 1px solid #ddd;">Số lượng</th>
                <th style="padding: 15px; text-align: center; border: 1px solid #ddd;">Thành tiền</th>
                <th style="padding: 15px; text-align: center; border: 1px solid #ddd;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">
                        <img src="~/Content/Images/@item.ProductImage" style="width: 80px; height: 80px; object-fit: cover; border-radius: 5px;" onerror="this.src='https://via.placeholder.com/80?text=No+Image'" />
                    </td>
                    <td style="padding: 10px; font-size: 16px; font-weight: bold; border: 1px solid #ddd;">@item.ProductName</td>
                    <td style="padding: 10px; text-align: center; color: #e74c3c; border: 1px solid #ddd;">@String.Format("{0:0,0}", item.UnitPrice) VNĐ</td>
                    <td style="padding: 10px; text-align: center; font-size: 16px; font-weight: bold; border: 1px solid #ddd;">
                        @item.Quantity
                    </td>
                    <td style="padding: 10px; text-align: center; color: #e74c3c; font-weight: bold; border: 1px solid #ddd;">@String.Format("{0:0,0}", item.TotalPrice) VNĐ</td>
                    <td style="padding: 10px; text-align: center; border: 1px solid #ddd;">
                        <a href="/Cart/RemoveFromCart/@item.ProductID" style="color: white; background-color: #e74c3c; padding: 5px 10px; text-decoration: none; border-radius: 3px; font-size: 14px; font-weight: bold;">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr style="background-color: #f8f9fa;">
                <td colspan="5" style="padding: 15px; text-align: right; font-size: 18px; font-weight: bold; border: 1px solid #ddd;">Tổng cộng:</td>
                <td style="padding: 15px; text-align: center; font-size: 20px; font-weight: bold; color: #c0392b; border: 1px solid #ddd;">
                    @String.Format("{0:0,0}", Model.Sum(m => m.TotalPrice)) VNĐ
                </td>
            </tr>
        </tfoot>
    </table>

    <div style="text-align: right; margin-top: 20px; margin-bottom: 50px;">
        <a href="/" style="background-color: #95a5a6; color: white; padding: 12px 20px; text-decoration: none; border-radius: 5px; font-size: 16px; margin-right: 10px;">
            Tiếp tục mua hàng
        </a>
        <!-- Nút Thanh toán này sẽ làm ở phần sau -->
        <a href="/Cart/Checkout" style="background-color: #e67e22; color: white; padding: 12px 25px; text-decoration: none; border-radius: 5px; font-size: 16px; font-weight: bold;">
            Tiến hành thanh toán ➔
        </a>
    </div>
}