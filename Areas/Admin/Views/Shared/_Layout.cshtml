<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị hệ thống</title>
</head>
<body style="margin: 0; font-family: Arial, sans-serif;">
    <div style="display: flex; min-height: 100vh;">

        <!-- Cột Menu (Sidebar) bên trái -->
        <div style="width: 250px; background-color: #2c3e50; color: white; padding: 20px;">
            <h2 style="margin-top: 0;">Admin Panel</h2>
            <hr style="border-color: #34495e;" />
            <ul style="list-style-type: none; padding: 0; line-height: 2.5;">
                <li><a href="/Admin/Categories" style="color: white; text-decoration: none; display: block;">📦 Quản lý Danh mục</a></li>
                <li><a href="/Admin/Products" style="color: white; text-decoration: none; display: block;">🛍️ Quản lý Sản phẩm</a></li>
                <li style="margin-top: 20px;"><a href="/" style="color: #1abc9c; text-decoration: none; display: block;">🏠 Trở về Trang chủ</a></li>
            </ul>
        </div>

        <!-- Cột Nội dung chính bên phải -->
        <div style="flex: 1; padding: 20px; background-color: #f8f9fa;">
            <!-- Hàm này sẽ tự động hút nội dung từ các file Index, Create, Edit... đắp vào đây -->
            @RenderBody()
        </div>

    </div>
</body>
</html>